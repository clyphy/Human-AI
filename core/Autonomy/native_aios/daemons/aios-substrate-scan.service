[Unit]
Description=Oceti Native AIOS scan
After=network.target

[Service]
Type=oneshot
ExecStart=/home/wayfinder/projects/Human-AI/core/Autonomy/native_aios/bin/aios scan
Environment=AIOS_NATIVE=/home/wayfinder/projects/Human-AI/core/Autonomy/native_aios AIOS_ROOT=/home/wayfinder/projects/Human-AI/core/Autonomy
StandardOutput=append:/home/wayfinder/projects/Human-AI/core/Autonomy/native_aios/logs/scan.log
StandardError=append:/home/wayfinder/projects/Human-AI/core/Autonomy/native_aios/logs/scan.log
